# MongoDB connection string (can reuse the notebook cluster, different db name)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/photos

# The password you type to unlock uploading
APP_PASSWORD=change-me

# Random string used to sign album access tokens
TOKEN_SECRET=change-me-too

# Cloudinary credentials from the dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional, defaults to 3000
PORT=3000
